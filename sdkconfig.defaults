# Adafruit ESP32 Feather V2: 8 MB flash
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 1 ms ticks so delays and timers line up with the 20 ms audio frame
CONFIG_FREERTOS_HZ=1000
# Run-time stats for vTaskGetRunTimeStats() in the monitor task
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
# Timer service task runs debounce and beacon timers; keep it above the UI task
CONFIG_FREERTOS_TIMER_TASK_PRIORITY=9
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3072

# Task watchdog: audio tasks subscribe, a hung pipeline resets the board
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y

# Keep the Wi-Fi stack on core 0 (default), audio tasks are pinned to core 1
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
